# Static CSS assets may remain aggressively cached because their version hash is stable.
/css/*
  Cache-Control: public, max-age=31536000, immutable

# JavaScript customizations are edited directly in GitHub/API, so never cache them.
# This avoids stale UI after Cloudflare Pages redeployments even when ?v= does not change.
/js/*
  Cache-Control: no-store

/favicon.svg
  Cache-Control: public, max-age=31536000, immutable

# HTML Files - Do not cache (Revalidate)
# Ensures users always get the latest version references
/*.html
  Cache-Control: public, max-age=0, must-revalidate
